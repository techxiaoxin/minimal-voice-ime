<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/panel_bg"
    android:orientation="vertical"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <!-- 转写进度：一条细线，识别和整理的时候才出现 -->


    <!-- 快捷面板，点最左边的设置键展开：换输入法、进设置。默认收起 -->
    <LinearLayout
        android:id="@+id/ll_quick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/row_switch_ime"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/iv_quick_ime"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/quick_switch_ime"
                android:src="@drawable/ic_grid" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/quick_switch_ime"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_open_settings"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/iv_quick_settings"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/quick_open_settings"
                android:src="@drawable/ic_settings" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/quick_open_settings"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 数字行，默认收起，点 123 展开，横向一排 -->
    <LinearLayout
        android:id="@+id/ll_numbers"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="2dp"
        android:paddingEnd="10dp"
        android:paddingBottom="2dp"
        android:visibility="gone" />

    <!-- 只有微博会显示这条，右侧一个小箭头切换键盘高度，给表情面板腾地方 -->
    <FrameLayout
        android:id="@+id/fl_expand"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_expand"
            android:layout_width="40dp"
            android:layout_height="24dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_btn"
            android:contentDescription="@string/btn_expand"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chevron" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/fl_keys"
        android:layout_width="match_parent"
        android:layout_height="56dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <!-- 左右两组等宽 82dp，中间的语音条才能正中对齐 -->
        <LinearLayout
            android:layout_width="96dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical|start"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_btn"
                android:contentDescription="@string/btn_settings"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_primary" />

            <!-- 文字态显示 123，数字态显示麦克风，两张图叠在一个框里，居中对齐 -->
            <FrameLayout
                android:id="@+id/btn_mode"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/bg_btn">

                <TextView
                    android:id="@+id/tv_mode_label"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/btn_mode_num"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/iv_mode_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/btn_voice"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_mic"
                    android:visibility="gone"
                    app:tint="@color/text_primary" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_voice"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_voice_bar"
            android:gravity="center"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/pb_inline"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_mic"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="@string/btn_voice"
                android:scaleType="centerInside"
                android:src="@drawable/ic_mic"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="none"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/voice_hint"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="96dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_delete"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_btn"
                android:contentDescription="@string/btn_delete"
                android:scaleType="centerInside"
                android:src="@drawable/ic_backspace"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="46dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/bg_btn"
                android:contentDescription="@string/btn_send"
                android:scaleType="centerInside"
                android:src="@drawable/ic_enter"
                app:tint="@color/text_primary" />
        </LinearLayout>
    </LinearLayout>

        <!-- 上滑到取消区才浮出来，压在语音条上方，不占额外高度 -->
        <TextView
            android:id="@+id/tv_swipe_hint"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_hint_chip"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/voice_swipe_cancel"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:visibility="invisible" />
    </FrameLayout>
</LinearLayout>
