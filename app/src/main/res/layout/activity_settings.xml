<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/panel_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="2dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/settings_title" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="2dp" android:background="@drawable/bg_segment_plain" android:orientation="horizontal" android:padding="2dp">
            <TextView android:id="@+id/tab_voice" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_chip_active" android:gravity="center" android:text="模型设置" android:textColor="@color/on_accent" android:textSize="12sp" />
            <TextView android:id="@+id/tab_more" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_chip_idle" android:gravity="center" android:text="其他设置" android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:background="@color/divider" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:background="@null" android:fillViewport="true" android:scrollbars="none" android:layout_weight="1" android:paddingTop="0dp" android:paddingBottom="0dp" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:paddingBottom="20dp">
            <LinearLayout android:id="@+id/group_voice" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="识别方式" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <TextView android:id="@+id/chip_cloud" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:background="@drawable/bg_chip_idle" android:gravity="center" android:text="云端模型" android:textColor="@color/text_secondary" android:textSize="12sp" />
                        <TextView android:id="@+id/chip_local" android:layout_width="0dp" android:layout_height="34dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_chip_idle" android:gravity="center" android:text="本地模型" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    </LinearLayout>
                    <TextView android:id="@+id/tv_mode_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingExtra="2dp" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    <LinearLayout android:id="@+id/ll_tokens" android:layout_width="match_parent" android:layout_height="26dp" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
                        <TextView android:id="@+id/tv_tokens" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textColor="@color/text_secondary" android:textSize="11sp" android:singleLine="true" android:gravity="center_vertical" android:includeFontPadding="false" />
                        <Button android:id="@+id/btn_token_log" android:text="明细" android:layout_width="wrap_content" android:layout_height="26dp" android:background="@drawable/bg_chip_idle" android:minWidth="52dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textAllCaps="false" android:textColor="@color/text_secondary" android:textSize="10sp" android:layout_marginStart="8dp" android:gravity="center" android:includeFontPadding="false" android:paddingTop="0dp" android:paddingBottom="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/group_local" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@null" android:orientation="vertical" android:padding="0dp" android:visibility="gone">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="模型规格" android:textColor="@color/text_primary" android:textSize="12sp" />
                        <RadioGroup android:id="@+id/rg_model_tier" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal">
                            <RadioButton android:id="@+id/rb_tier_light" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:buttonTint="@color/text_primary" android:paddingStart="0dp" android:paddingEnd="4dp" android:text="标准 252MB" android:textColor="@color/text_primary" android:textSize="12sp" />
                            <RadioButton android:id="@+id/rb_tier_hq" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:buttonTint="@color/text_primary" android:paddingStart="0dp" android:paddingEnd="4dp" android:text="高精度 903MB" android:textColor="@color/text_primary" android:textSize="12sp" />
                        </RadioGroup>
                        <TextView android:id="@+id/tv_model_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:lineSpacingExtra="2dp" android:textColor="@color/text_secondary" android:textSize="11sp" />
                        <EditText android:id="@+id/et_local_url" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="6dp" android:background="@drawable/bg_input" android:importantForAutofill="no" android:inputType="textUri" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="12sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="地址可以改成你自己的，文件名要对得上。" android:textColor="@color/text_secondary" android:textSize="11sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="10dp" android:orientation="horizontal">
                            <Button android:id="@+id/btn_download" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_btn_primary" android:text="下载模型" android:textAllCaps="false" android:textColor="@color/on_accent" android:textSize="12sp" />
                            <Button android:id="@+id/btn_local_test" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_btn_secondary" android:text="测试本地模型" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="12sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/tv_local_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/group_cloud" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@null" android:orientation="vertical" android:padding="0dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="接口地址" android:textColor="@color/text_secondary" android:textSize="11sp" />
                        <EditText android:id="@+id/et_endpoint" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="4dp" android:background="@drawable/bg_input" android:hint="https://…" android:importantForAutofill="no" android:inputType="textUri" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="12sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="API Key" android:textColor="@color/text_secondary" android:textSize="11sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="4dp" android:orientation="horizontal">
                            <EditText android:id="@+id/et_apikey" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_input" android:hint="sk-…" android:importantForAutofill="no" android:inputType="textPassword" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="12sp" />
                            <ImageButton android:id="@+id/btn_eye" android:layout_width="40dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:background="@drawable/bg_btn_secondary" android:contentDescription="@string/settings_key_show" android:src="@drawable/ic_eye" app:tint="@color/text_primary" />
                        </LinearLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="识别模型" android:textColor="@color/text_secondary" android:textSize="11sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="4dp" android:orientation="horizontal">
                            <EditText android:id="@+id/et_model" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_input" android:hint="qwen-audio-3.1-asr-flash" android:importantForAutofill="no" android:inputType="text" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="12sp" />
                            <Button android:id="@+id/btn_test" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="8dp" android:minWidth="88dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/bg_btn_primary" android:text="@string/settings_test_key" android:textAllCaps="false" android:textColor="@color/on_accent" android:textSize="12sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/tv_key_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" android:textSize="11sp" android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/settings_polish" android:textColor="@color/text_primary" android:textSize="14sp" />
                        <Switch android:id="@+id/sw_polish" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:lineSpacingExtra="2dp" android:text="@string/settings_polish_hint" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    <RadioGroup android:id="@+id/rg_polish_engine" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <RadioButton android:id="@+id/rb_polish_cloud" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:buttonTint="@color/accent" android:text="@string/polish_engine_cloud" android:textColor="@color/text_primary" android:textSize="13sp" />
                        <RadioButton android:id="@+id/rb_polish_local" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:buttonTint="@color/accent" android:text="@string/polish_engine_local" android:textColor="@color/text_primary" android:textSize="13sp" />
                    </RadioGroup>
                    <LinearLayout android:id="@+id/group_polish_cloud" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="整理模型" android:textColor="@color/text_secondary" android:textSize="11sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="4dp" android:orientation="horizontal">
                            <EditText android:id="@+id/et_polish_model" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_input" android:hint="qwen3.8-flash" android:importantForAutofill="no" android:inputType="text" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="12sp" />
                            <Button android:id="@+id/btn_polish_test" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="8dp" android:background="@drawable/bg_btn_primary" android:minWidth="76dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="测试整理" android:textAllCaps="false" android:textColor="@color/on_accent" android:textSize="12sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/tv_polish_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" android:textSize="11sp" android:visibility="gone" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingExtra="2dp" android:text="识别和整理是两个模型，额度在控制台分开统计，用量也分开显示。" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    </LinearLayout>
                    <RadioGroup android:id="@+id/rg_llm_tier" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal" android:visibility="gone">
                        <RadioButton android:id="@+id/rb_llm_small" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:buttonTint="@color/accent" android:text="小模型 409MB" android:textColor="@color/text_primary" android:textSize="12sp" />
                        <RadioButton android:id="@+id/rb_llm_big" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:buttonTint="@color/accent" android:text="大模型 718MB" android:textColor="@color/text_primary" android:textSize="12sp" />
                    </RadioGroup>
                    <TextView android:id="@+id/tv_llm_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    <Button android:id="@+id/btn_llm_download" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="6dp" android:text="@string/llm_download" android:textSize="13sp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:layout_marginBottom="10dp" android:background="@color/divider" />
                    <TextView android:id="@+id/tv_test" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" android:textSize="11sp" android:visibility="gone" />
                    <TextView android:id="@+id/tv_polish_rules" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="查看和修改整理规则" android:textColor="@color/text_secondary" android:textSize="11sp" android:paddingTop="4dp" android:paddingBottom="4dp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/group_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="词库与快捷输入" android:textColor="@color/text_primary" android:textSize="13sp" />
                    <TextView android:id="@+id/tv_phrase_personal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="个人词库" android:textColor="@color/accent" android:textSize="14sp" android:paddingTop="6dp" android:paddingBottom="2dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="发票抬头、税号、手机号这类固定信息" android:textColor="@color/text_secondary" android:textSize="11sp" android:paddingBottom="6dp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:background="@color/divider" />
                    <TextView android:id="@+id/tv_phrase_quick" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="快捷输入" android:textColor="@color/text_primary" android:textSize="14sp" android:paddingTop="6dp" android:paddingBottom="2dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="常用回复、地址、套话这类整段文字" android:textColor="@color/text_secondary" android:textSize="11sp" android:paddingBottom="6dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="打缩写就出内容：发票抬头存成 fp，手机号存成 sjh，打字时打成这几个字母，候选条第一排就是它。" android:textColor="@color/text_secondary" android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="键盘外观" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_marginBottom="6dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:background="@drawable/bg_segment_plain" android:orientation="horizontal" android:padding="3dp">
                        <TextView android:id="@+id/chip_auto" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_chip_active" android:gravity="center" android:text="自动" android:textColor="@color/on_accent" android:textSize="12sp" />
                        <TextView android:id="@+id/chip_light" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_chip_idle" android:gravity="center" android:text="白色" android:textColor="@color/text_secondary" android:textSize="12sp" />
                        <TextView android:id="@+id/chip_dark" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_chip_idle" android:gravity="center" android:text="黑色" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="跟随手机" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:layout_marginBottom="8dp" android:background="@color/divider" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="中间键单击" android:textColor="@color/text_primary" android:textSize="13sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="8dp" android:background="@drawable/bg_segment_plain" android:orientation="horizontal" android:padding="3dp">
                        <TextView android:id="@+id/chip_space" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_chip_active" android:gravity="center" android:text="打一个空格" android:textColor="@color/on_accent" android:textSize="12sp" />
                        <TextView android:id="@+id/chip_send" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_chip_idle" android:gravity="center" android:text="说完后发送" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/settings_prefer_bt" android:textColor="@color/text_primary" android:textSize="14sp" />
                        <Switch android:id="@+id/sw_prefer_bt" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="固定名词，一行一个" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    <EditText android:id="@+id/et_vocab" android:layout_width="match_parent" android:layout_height="76dp" android:layout_marginTop="4dp" android:background="@drawable/bg_input" android:gravity="top|start" android:hint="名字、产品名、术语，一行一个" android:importantForAutofill="no" android:inputType="textMultiLine" android:padding="10dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="12sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <EditText android:id="@+id/et_punct" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_input" android:hint="标点规则" android:importantForAutofill="no" android:inputType="text" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="12sp" />
                        <EditText android:id="@+id/et_filter" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_input" android:hint="语气词过滤" android:importantForAutofill="no" android:inputType="text" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="同一 WiFi 同步词库" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_marginBottom="6dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <EditText android:id="@+id/et_device" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_input" android:hint="本机名称" android:importantForAutofill="no" android:inputType="text" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="12sp" />
                        <Button android:id="@+id/btn_scan" android:layout_width="wrap_content" android:minWidth="96dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:background="@drawable/bg_btn_secondary" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/settings_sync" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="12sp" />
                    </LinearLayout>
                    <TextView android:id="@+id/tv_peers" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" android:text="点右边按钮搜同一 WiFi 下的设备" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    <LinearLayout android:id="@+id/ll_peers" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="已下载的模型" android:textColor="@color/text_primary" android:textSize="14sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="用不上的可以直接删" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/ll_models" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="12dp" android:background="@color/panel_bg">
        <Button android:id="@+id/btn_save" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="0dp" android:background="@drawable/bg_btn_primary" android:text="@string/settings_save" android:textAllCaps="false" android:textColor="@color/on_accent" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>