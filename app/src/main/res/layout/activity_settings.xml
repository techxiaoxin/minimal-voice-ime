<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/panel_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_marginEnd="8dp" android:contentDescription="@string/settings_title" android:src="@drawable/ic_brand" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/settings_title" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/ll_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="30dp" android:orientation="horizontal" android:paddingStart="6dp" android:paddingEnd="2dp">
                <TextView android:id="@+id/tv_update_dot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="3dp" android:text="●" android:textColor="@color/recording" android:textSize="8sp" android:visibility="gone" />
                <TextView android:id="@+id/tv_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="2dp" android:background="@drawable/bg_segment_plain" android:orientation="horizontal" android:padding="2dp">
            <TextView android:id="@+id/tab_voice" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_chip_active" android:gravity="center" android:text="模型设置" android:textColor="@color/on_accent" android:textSize="12sp" />
            <TextView android:id="@+id/tab_more" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_chip_idle" android:gravity="center" android:text="其他设置" android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="6dp" android:background="@color/divider" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:background="@null" android:fillViewport="true" android:scrollbars="none" android:layout_weight="1" android:paddingTop="0dp" android:paddingBottom="0dp" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="8dp" android:paddingEnd="16dp" android:paddingBottom="20dp">
            <LinearLayout android:id="@+id/group_voice" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="识别方式" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <TextView android:id="@+id/chip_cloud" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:background="@drawable/bg_chip_idle" android:gravity="center" android:text="云端模型" android:textColor="@color/text_secondary" android:textSize="12sp" />
                        <TextView android:id="@+id/chip_local" android:layout_width="0dp" android:layout_height="34dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_chip_idle" android:gravity="center" android:text="本地模型" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    </LinearLayout>
                    <TextView android:id="@+id/tv_mode_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingExtra="2dp" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    <LinearLayout android:id="@+id/ll_tokens" android:layout_width="match_parent" android:layout_height="26dp" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
                        <TextView android:id="@+id/tv_tokens" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textColor="@color/text_secondary" android:textSize="11sp" android:singleLine="true" android:gravity="center_vertical" android:includeFontPadding="false" />
                        <Button android:id="@+id/btn_token_log" android:text="明细" android:layout_width="wrap_content" android:layout_height="26dp" android:background="@drawable/bg_chip_idle" android:minWidth="52dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textAllCaps="false" android:textColor="@color/text_secondary" android:textSize="10sp" android:layout_marginStart="8dp" android:gravity="center" android:includeFontPadding="false" android:paddingTop="0dp" android:paddingBottom="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/group_local" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@null" android:orientation="vertical" android:padding="0dp" android:visibility="gone">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="模型规格" android:textColor="@color/text_primary" android:textSize="12sp" />
                        <RadioGroup android:id="@+id/rg_model_tier" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="2dp" android:orientation="horizontal">
                            <RadioButton android:id="@+id/rb_tier_light" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:buttonTint="@color/text_primary" android:gravity="center_vertical" android:lineSpacingExtra="2dp" android:paddingStart="0dp" android:paddingEnd="2dp" android:text="标准\n252M" android:maxLines="2" android:singleLine="false" android:ellipsize="none" android:textColor="@color/text_primary" android:textSize="11sp" />
                            <RadioButton android:id="@+id/rb_tier_hq" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:buttonTint="@color/text_primary" android:gravity="center_vertical" android:lineSpacingExtra="2dp" android:paddingStart="0dp" android:paddingEnd="2dp" android:text="高精度\n903M" android:maxLines="2" android:singleLine="false" android:ellipsize="none" android:textColor="@color/text_primary" android:textSize="11sp" />
                            <RadioButton android:id="@+id/rb_tier_custom" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:buttonTint="@color/text_primary" android:gravity="center_vertical" android:lineSpacingExtra="2dp" android:paddingStart="0dp" android:paddingEnd="2dp" android:text="自定义模型" android:maxLines="1" android:ellipsize="none" android:textColor="@color/text_primary" android:textSize="11sp" />
                        </RadioGroup>
                        <TextView android:id="@+id/tv_model_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:lineSpacingExtra="2dp" android:textColor="@color/text_secondary" android:textSize="11sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="10dp" android:orientation="horizontal">
                            <Button android:id="@+id/btn_download" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_btn_primary" android:text="下载模型" android:textAllCaps="false" android:textColor="@color/on_accent" android:textSize="12sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/tv_local_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/group_cloud" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@null" android:orientation="vertical" android:padding="0dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="接口地址" android:textColor="@color/text_secondary" android:textSize="11sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/hint_endpoint" android:textColor="@color/text_hint" android:textSize="10sp" />
                        <EditText android:id="@+id/et_endpoint" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="4dp" android:background="@drawable/bg_input" android:hint="https://…" android:importantForAutofill="no" android:inputType="textUri" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="12sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="API Key" android:textColor="@color/text_secondary" android:textSize="11sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="4dp" android:orientation="horizontal">
                            <EditText android:id="@+id/et_apikey" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_input" android:hint="sk-…" android:importantForAutofill="no" android:inputType="textPassword" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="12sp" />
                            <ImageButton android:id="@+id/btn_eye" android:layout_width="40dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:background="@drawable/bg_btn_secondary" android:contentDescription="@string/settings_key_show" android:src="@drawable/ic_eye" app:tint="@color/text_primary" />
                        </LinearLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/settings_asr_model_label" android:textColor="@color/text_secondary" android:textSize="11sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="4dp" android:background="@drawable/bg_input" android:orientation="horizontal">
                            <AutoCompleteTextView android:id="@+id/et_model" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@null" android:completionThreshold="1" android:hint="qwen-audio-3.1-asr-flash" android:importantForAutofill="no" android:inputType="text" android:paddingStart="10dp" android:paddingEnd="2dp" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="12sp" />
                            <TextView android:id="@+id/tv_model_arrow" android:layout_width="34dp" android:layout_height="match_parent" android:gravity="center" android:text="@string/settings_arrow_down" android:textColor="@color/text_secondary" android:textSize="14sp" android:clickable="true" android:focusable="false" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                                <Button android:id="@+id/btn_fetch_models" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_btn_secondary" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="@string/settings_fetch_models" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="12sp" />
                                <com.minivoice.ime.ui.ProgressRingView android:id="@+id/ring_fetch_models" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" />
                            </FrameLayout>
                            <Button android:id="@+id/btn_test" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_btn_primary" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="@string/settings_test_key" android:textAllCaps="false" android:textColor="@color/on_accent" android:textSize="12sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/tv_stream_legend" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="黑色字体不支持流式输入    绿色字体支持流式输入" android:textColor="@color/text_primary" android:textSize="10sp" />
                        <TextView android:id="@+id/tv_key_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" android:textSize="11sp" android:visibility="gone" />

                        <TextView android:id="@+id/tv_model_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_chip_idle" android:lineSpacingExtra="2dp" android:paddingStart="8dp" android:paddingTop="5dp" android:paddingEnd="8dp" android:paddingBottom="5dp" android:text="选好模型后，这里显示是否支持流式输入" android:textColor="@color/text_primary" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/settings_polish" android:textColor="@color/text_primary" android:textSize="14sp" />
                        <Switch android:id="@+id/sw_polish" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:lineSpacingExtra="2dp" android:text="@string/settings_polish_hint" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <Button android:id="@+id/btn_polish_cloud" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_chip_active" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="@string/polish_engine_cloud" android:textAllCaps="false" android:textColor="@color/on_accent" android:textSize="12sp" />
                        <Button android:id="@+id/btn_polish_local" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_chip_idle" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="@string/polish_engine_local" android:textAllCaps="false" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/ll_polish_sync_row" android:layout_width="match_parent" android:layout_height="34dp" android:visibility="gone" android:layout_marginTop="8dp" android:background="@null" android:orientation="horizontal">
                        <TextView android:id="@+id/btn_polish_sync" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_btn_primary" android:gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp" android:text="@string/settings_polish_sync" android:textColor="@color/on_accent" android:textSize="11sp" android:maxLines="1" android:singleLine="true" android:ellipsize="end" android:clickable="true" />
                        <TextView android:id="@+id/tv_polish_adv_toggle" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="6dp" android:background="@drawable/bg_btn_secondary" android:gravity="center" android:minWidth="100dp" android:paddingStart="8dp" android:paddingEnd="10dp" android:text="@string/settings_polish_expand" android:textColor="@color/text_primary" android:textSize="11sp" android:maxLines="1" android:singleLine="true" android:clickable="true" android:focusable="false" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/group_polish_cloud" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <LinearLayout android:id="@+id/group_polish_adv" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/settings_polish_endpoint_label" android:textColor="@color/text_secondary" android:textSize="11sp" />
                            <EditText android:id="@+id/et_polish_endpoint" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="4dp" android:background="@drawable/bg_input" android:hint="https://api.deepseek.com/v1/chat/completions" android:importantForAutofill="no" android:inputType="textUri" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="12sp" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:lineSpacingExtra="2dp" android:text="@string/hint_polish_endpoint" android:textColor="@color/text_hint" android:textSize="10sp" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/settings_polish_key_label" android:textColor="@color/text_secondary" android:textSize="11sp" />
                            <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="4dp" android:orientation="horizontal">
                                <EditText android:id="@+id/et_polish_key" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_input" android:hint="留空就用上面识别的 Key" android:importantForAutofill="no" android:inputType="textPassword" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="12sp" />
                                <ImageButton android:id="@+id/btn_polish_key_eye" android:layout_width="40dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:background="@drawable/bg_btn_secondary" android:contentDescription="@string/settings_key_show" android:src="@drawable/ic_eye" app:tint="@color/text_primary" />
                            </LinearLayout>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:lineSpacingExtra="2dp" android:text="@string/hint_polish_key" android:textColor="@color/text_hint" android:textSize="10sp" />
                        </LinearLayout>

                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/settings_polish_model_label" android:textColor="@color/text_secondary" android:textSize="11sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="4dp" android:background="@drawable/bg_input" android:orientation="horizontal">
                            <AutoCompleteTextView android:id="@+id/et_polish_model" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@null" android:completionThreshold="1" android:hint="qwen3.8-flash" android:importantForAutofill="no" android:inputType="text" android:paddingStart="10dp" android:paddingEnd="2dp" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="12sp" />
                            <TextView android:id="@+id/tv_polish_model_arrow" android:layout_width="34dp" android:layout_height="match_parent" android:gravity="center" android:text="@string/settings_arrow_down" android:textColor="@color/text_secondary" android:textSize="14sp" android:clickable="true" android:focusable="false" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                                <Button android:id="@+id/btn_polish_fetch" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_btn_secondary" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="@string/settings_fetch_models" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="12sp" />
                                <com.minivoice.ime.ui.ProgressRingView android:id="@+id/ring_polish_fetch" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" />
                            </FrameLayout>
                            <Button android:id="@+id/btn_polish_test" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_btn_primary" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="AI整理测试" android:textAllCaps="false" android:textColor="@color/on_accent" android:textSize="12sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/tv_polish_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" android:textSize="11sp" android:visibility="gone" />

                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:lineSpacingExtra="2dp" android:text="@string/hint_polish_model" android:textColor="@color/text_hint" android:textSize="10sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingExtra="2dp" android:text="@string/hint_polish_no_asr" android:textColor="@color/text_hint" android:textSize="10sp" />
                        <TextView android:id="@+id/tv_polish_check" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="10sp" android:visibility="gone" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingExtra="2dp" android:text="识别和整理是两个模型，额度在控制台分开统计，用量也分开显示。" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    </LinearLayout>
                    <RadioGroup android:id="@+id/rg_llm_tier" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="4dp" android:orientation="horizontal" android:visibility="gone">
                        <RadioButton android:id="@+id/rb_llm_small" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:buttonTint="@color/accent" android:gravity="center_vertical" android:lineSpacingExtra="1dp" android:paddingStart="0dp" android:paddingEnd="2dp" android:text="@string/llm_tier_small" android:textColor="@color/text_primary" android:textSize="10sp" />
                        <RadioButton android:id="@+id/rb_llm_big" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:buttonTint="@color/accent" android:gravity="center_vertical" android:lineSpacingExtra="1dp" android:paddingStart="0dp" android:paddingEnd="2dp" android:text="@string/llm_tier_big" android:textColor="@color/text_primary" android:textSize="10sp" />
                        <RadioButton android:id="@+id/rb_llm_custom" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:buttonTint="@color/accent" android:gravity="center_vertical" android:lineSpacingExtra="1dp" android:paddingStart="0dp" android:paddingEnd="2dp" android:text="@string/llm_tier_custom" android:textColor="@color/text_primary" android:textSize="10sp" />
                    </RadioGroup>
                    <TextView android:id="@+id/tv_llm_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    <Button android:id="@+id/btn_llm_download" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="6dp" android:background="@drawable/bg_btn_primary" android:text="@string/llm_download" android:textAllCaps="false" android:textColor="@color/on_accent" android:textSize="13sp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingTop="0dp" android:paddingBottom="0dp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:layout_marginBottom="10dp" android:background="@color/divider" />
